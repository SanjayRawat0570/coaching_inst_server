# ─────────────────────────────────────────────────────────────────────────────
# backend/.env.example  —  template. Copy to backend/.env and fill in real values.
# Never commit backend/.env (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM APIs (all free, no credit card) ──────────────────────────────────────
# Primary -> Groq, fallback -> Gemini, third -> OpenRouter (graph/llm.py)
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Optional: model per provider (defaults in graph/llm.py) and seconds per call
# before failing over to the next provider.
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# LLM_TIMEOUT=20

# ── Supabase (auth + Postgres + pgvector) ────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
# Service-role key — BACKEND ONLY, bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_KEY=
# Direct Postgres URL — used by the PostgresSaver checkpointer.
SUPABASE_DB_URL=
# Long-term memory lives in Supabase pgvector (student_memories) — no vector DB to set up.

# ── RAG_SERVER (the only RAG — rag/rag_server_client.py) ─────────────────────
# Base URL of the hosted RAG_SERVER, without /api/v1.
RAG_SERVER_URL=
# Default tenant-scoped key (role "member"). Used for any institute that has no
# rag_tenant + institute_secrets.rag_api_key of its own. Never sent to the browser.
RAG_SERVER_API_KEY=
# Default tenant slug that key belongs to (defaults to "smartcoaching").
RAG_SERVER_TENANT=
# Seconds per request (streamed answers allow up to 120 s between chunks).
RAG_SERVER_TIMEOUT=30

# ── Email (parent reports / reminders) — Resend free tier, 100 emails/day ────
RESEND_API_KEY=

# ── App config ───────────────────────────────────────────────────────────────
APP_ENV=development
PORT=8000
AT_RISK_THRESHOLD=70
REVIEWER_MAX_ITERATIONS=3
SESSION_TIMEOUT_MINUTES=30
WORKING_MEMORY_TURNS=10
# Days without activity before a student gets an inactivity alert (agents/inactivity_alert_agent.py)
INACTIVE_ALERT_DAYS=3

# ── Optional (sensible defaults exist in code — override only if needed) ──────
# Local SQLite checkpoint file when SUPABASE_DB_URL is unset (graph/checkpointer.py)
# CHECKPOINT_DB=/tmp/coaching_checkpoints.sqlite
# Whisper model size for lecture transcription: tiny|base|small|medium|large
# WHISPER_MODEL=base
# Load the embedding model + Supabase client in the background at startup (0 = off)
# WARM_START=1
# Where sentence-transformers caches the embedding model
# SENTENCE_TRANSFORMERS_HOME=/tmp/sentence_transformers
