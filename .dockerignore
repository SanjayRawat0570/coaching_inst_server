# Keep the Railway/HF Docker build context small & fast.
# Build context is the repo root; the backend Dockerfile only needs backend/.
.git
.github
.venv
.venv311
venv
env

# Frontend is deployed separately (Vercel) — never needed in the backend image
frontend

# Python caches
**/__pycache__
*.py[cod]
*.egg-info
**/.pytest_cache
**/node_modules

# Not needed at runtime
backend/tests
backend/pytest.ini
backend/requirements-dev.txt
backend/requirements-verify.txt

# Model / RAG caches (downloaded at runtime into /tmp)
tmp/
*.pt
*.bin

# Secrets & local docs (env vars are set in the Railway dashboard)
.env
*.env
!.env.example
README.md
instruction.md
DEPLOYMENT.md
