# ─────────────────────────────────────────────────────────────────────────────
# Secrets & environment — NEVER commit real keys.
# Every .env variant is ignored everywhere in the repo; only *.example is kept.
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env

# Keep the templates so others know which keys to set
!.env.example
!**/.env.example
!.env.local.example
!**/.env.local.example

# Other secret material
*.pem
*.key
*.p12
*.pfx
secrets.json
service-account*.json
credentials*.json

# ── Python (backend) ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
.venv311/
venv/
env/
ENV/

# ── Model / RAG caches ───────────────────────────────────────────────────────
/tmp/
*.pt
*.bin
*.onnx

# ── Node / Next.js (frontend) ────────────────────────────────────────────────
node_modules/
.next/
out/
build/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Data (large PDFs — index into Qdrant, don't commit) ──────────────────────
backend/data/ncert_pdfs/
backend/data/pyq_bank/
backend/data/nta_cutoffs/

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
